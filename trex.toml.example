# copy to trex.toml; it holds api keys, so it is gitignored
# any provider that speaks the openai responses api works

[providers.local]
base_url = "http://127.0.0.1:8699/v1"
api_key = ""

[[models]]
id = "gpt-6.1-sol"      # what the ui selects
name = "GPT 6.1 Sol"    # optional, shown in the model picker, defaults to id
provider = "local"
# upstream = "..."      # model name sent to the provider, defaults to id
# context_window = 400000  # tokens, defaults to 128000; compaction starts at 80%
# reasoning_efforts = ["low", "medium", "high"]  # levels sessions may pick; any when omitted
# fast = true              # sessions may use the priority service tier (faster, more credits)
# price = { input = 1_250_000, cached_input = 125_000, output = 10_000_000 }  # credits per million tokens (1 credit = $0.000001, so this is $1.25/$0.125/$10); fast_multiplier defaults to 2

# billing plans; without any, credits are tracked but never enforced
# [plans.free]
# name = "Free"
# monthly_credits = 5_000_000   # $5; the balance is topped up to this once a month

# speech-to-text for the agent's transcribe tool; any server speaking the openai audio api, such
# as a local speaches (faster-whisper) or openai; without it the tool isn't offered
# [transcription]
# base_url = "http://127.0.0.1:8000/v1"
# api_key = ""
# model = "deepdml/faster-whisper-large-v3-turbo-ct2"
