# copy to .env next to compose.yaml

POSTGRES_PASSWORD=change-me
VALKEY_PASSWORD=change-me
TREX_DATABASE_URL=postgres://trex:change-me@127.0.0.1:5432/trex
TREX_REDIS_URL=redis://:change-me@127.0.0.1:6379

TREX_ADDR=0.0.0.0:8080
TREX_PREVIEW_ADDR=0.0.0.0:8081
TREX_PREVIEW_URL=http://{id}.preview.192.168.0.100.nip.io:8081

TREX_INSECURE_COOKIES=true
TREX_TRUST_PROXY_HEADERS=false

TREX_OPENSHELL_ENDPOINT=https://127.0.0.1:17670
TREX_SANDBOX_IMAGE=localhost/trex-sandbox:latest
TREX_SANDBOX_IDLE_SECS=300

# the cloudflare tunnels token
CLOUDFLARE_TUNNEL_TOKEN=
