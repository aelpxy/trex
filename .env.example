# copy to .env and fill in; variables already set in the environment take precedence

# http listen address
TREX_ADDR=127.0.0.1:8080

# log output: text or json; RUST_LOG overrides the default filter
TREX_LOG_FORMAT=text
# RUST_LOG=info,trex=debug

# model catalog: providers (with api keys) and models; see trex.toml.example
TREX_CONFIG=trex.toml

# openshell gateway (tunnel: ssh -fN -L 17670:127.0.0.1:17670 fedora-server)
TREX_OPENSHELL_ENDPOINT=https://127.0.0.1:17670
# directory with ca.crt, tls.crt, tls.key
TREX_OPENSHELL_TLS_DIR=certs/openshell

# session sandboxes: image built from images/sandbox on the gateway host, and the default network policy
TREX_SANDBOX_IMAGE=localhost/trex-sandbox:latest
TREX_SANDBOX_POLICY=sandbox-policy.yaml
# stop a session's sandbox after this many idle seconds; its files are kept and it restarts when a tool needs it
TREX_SANDBOX_IDLE_SECS=300

# user file library: a local directory, or any s3-compatible bucket when TREX_S3_BUCKET is set
TREX_LIBRARY_DIR=data/library
# TREX_S3_BUCKET=
# TREX_S3_ENDPOINT=https://s3.example.com
# TREX_S3_REGION=us-east-1
# TREX_S3_ACCESS_KEY_ID=
# TREX_S3_SECRET_ACCESS_KEY=
# TREX_S3_FORCE_PATH_STYLE=false

# serves apps running in sandboxes; every preview gets its own subdomain, so {id} must start the host
# TREX_PREVIEW_ADDR=127.0.0.1:8081
# TREX_PREVIEW_URL=http://{id}.preview.localhost:8081

# enables the /v1/admin endpoints (credit top-ups, plans); a secret

# required
TREX_DATABASE_URL=postgres://user:password@host:5432/trex
TREX_REDIS_URL=redis://default:password@host:6379

